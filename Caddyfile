{
	admin off
	auto_https off
}
:{$PORT} {
	map {http.request.header.X-Forwarded-Proto} {public_scheme} {
		https https
		default {http.request.scheme}
	}
	@private path /api/standalone/import* /api/standalone/admin* /cdn-cgi/*
	respond @private "Not found" 404
	reverse_proxy 127.0.0.1:8080 {
		header_up -CF-Connecting-IP
		header_up X-Forwarded-Proto {public_scheme}
		flush_interval -1
	}
}
